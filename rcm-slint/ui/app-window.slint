// Context menu UI rendered with Slint — replaces the React/HTML frontend.
// Uses click-based navigation (like native Windows menus) with flat item lists.

import { VerticalBox, HorizontalBox } from "std-widgets.slint";

// ── Data structures (must precede usage) ────────────────────────────────

export struct CommandData {
    exe: string,
    args: [string],
    cwd: string,
    admin: bool,
    window: string,
}

export struct MenuItemData {
    key: string,
    icon: string,
    label: string,
    disable: bool,
    admin: bool,
    window: string,
    has-children: bool,
    is-separator: bool,
    command: CommandData,
}

// ── Reusable menu item row component ───────────────────────────────────

component MenuRow {
    in property <string> label;
    in property <string> icon;
    in property <bool> disable;
    in property <bool> has-children;
    in property <bool> show-icon;

    callback clicked();

    height: 28px;
    min-width: 200px;
    horizontal-stretch: 1;

    bg := Rectangle {
        background: root.disable ? #00000000 : (ta.has-hover ? #ffffff18 : #00000000);
        border-radius: 4px;

        ta := TouchArea {
            enabled: !root.disable;
            clicked => {
                root.clicked();
            }
        }

        HorizontalBox {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;

            if root.show-icon && root.icon != "" : Rectangle {
                width: 18px;
                height: 18px;
                clip: true;
                Text {
                    text: root.icon;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    color: #cccccc;
                }
            }

            label-text := Text {
                text: root.label;
                vertical-alignment: center;
                color: root.disable ? #666666 : #e0e0e0;
                horizontal-stretch: 1;
            }

            if root.has-children : Text {
                text: ">";
                font-size: 11px;
                vertical-alignment: center;
                horizontal-alignment: right;
                color: #777777;
            }
        }
    }
}

// ── Global state — bridge between Rust and Slint ────────────────────────

export global GlobalState {
    in-out property <bool> icons-visible;
    in-out property <bool> menu-active;
}

// ── Root context menu window ────────────────────────────────────────────

export component MenuWindow inherits Window {
    title: "rcm-menu";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-size: 13px;

    in-out property <[MenuItemData]> icon-items;
    in-out property <[MenuItemData]> items;
    in-out property <int> depth: 0;
    in-out property <bool> show-icons;

    // Callbacks: Slint → Rust
    callback submenu-requested(int /* depth */, [int] /* path */);
    callback item-executed(int /* depth */, [int] /* path */, string /* exe */, [string] /* args */, string /* cwd */, bool /* admin */, string /* window */);
    callback window-blurred(int /* depth */);

    container := Rectangle {
        background: #202020e6;
        border-radius: 8px;
        border-width: 1px;
        border-color: #333333;

        VerticalBox {
            padding: 4px;
            spacing: 0;

            // Icon ribbon
            if root.show-icons && root.icon-items.length > 0 : HorizontalBox {
                padding: 4px;
                spacing: 3px;
                alignment: center;

                for icon-item[idx] in root.icon-items : Rectangle {
                    width: 36px;
                    height: 32px;
                    border-radius: 4px;
                    background: icon-item.disable ? #00000000 : (ta2.has-hover ? #33333333 : #00000000);

                    ta2 := TouchArea {
                        enabled: !icon-item.disable;
                        clicked => {
                            if icon-item.command.exe != "" {
                                root.item-executed(root.depth, [-1, idx], icon-item.command.exe, icon-item.command.args, icon-item.command.cwd, icon-item.command.admin, icon-item.command.window);
                            } else if icon-item.has-children {
                                root.submenu-requested(root.depth, [-1, idx]);
                            }
                        }
                    }

                    Text {
                        text: icon-item.icon != "" ? icon-item.icon : icon-item.label;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: icon-item.disable ? #777777 : #dddddd;
                    }
                }

                // Separator after icon ribbon
                Rectangle {
                    height: 1px;
                    background: #3a3a3a;
                    horizontal-stretch: 1;
                }

                VerticalBox {
                    height: 4px;
                }
            }

            // Flat list of menu items with separator support
            for item[idx] in root.items : VerticalBox {
                if item.is-separator : Rectangle {
                    height: 1px;
                    background: #2a2a2a;
                    horizontal-stretch: 1;
                }

                if item.is-separator : VerticalBox {
                    height: 4px;
                }

                if !item.is-separator : MenuRow {
                    label: item.label;
                    icon: item.icon;
                    disable: item.disable;
                    has-children: item.has-children;
                    show-icon: root.show-icons;

                    clicked => {
                        if item.command.exe != "" {
                            root.item-executed(root.depth, [idx], item.command.exe, item.command.args, item.command.cwd, item.command.admin, item.command.window);
                        } else if item.has-children {
                            root.submenu-requested(root.depth, [idx]);
                        }
                    }
                }
            }
        }
    }
}



