{
  "name": "rcm-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:rcm && vite",
    "build:rcm": "cd rcm && npm run build",
    "build": "pnpm run build:rcm && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "pnpm run lint-ts && pnpm run lint-rs",
    "lint-ts": "cd src && deno fmt && deno lint --fix",
    "icon": "tauri icon ./public/icon.png",
    "lint-rs": "cd src-tauri && cargo fmt --all &&  cargo clippy --fix --allow-dirty --allow-staged"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "rcm": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}